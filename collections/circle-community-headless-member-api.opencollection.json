{
  "opencollection": "1.0.0",
  "info": {
    "name": "Circle Developer Platform Admin - Courses Headless - Member API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
